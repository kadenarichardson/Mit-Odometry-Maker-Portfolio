  //Color Detected:  0 =  none, 1 = red, 2 = blue 
  int DetectColor(){
    ColorSensor.setLight(ledState::on);
    ColorSensor.integrationTime(10);
    //detect a hue
   int HueDetected = ColorSensor.hue();
    //Red detected
    if (HueDetected <40) {
      Brain.Screen.clearScreen();
      Brain.Screen.print("Red");
      Brain.Screen.setFillColor(red);
      Brain.Screen.drawRectangle(0, 0, 479, 239);
      return 1;
    }
    //Blue Detected
    else if (HueDetected >150) {
      Brain.Screen.clearScreen();
      Brain.Screen.print("Blue");
      Brain.Screen.setFillColor(blue);
      Brain.Screen.drawRectangle(0, 0, 479, 239);
      return 2;
    }
    //nothing detected
    else {
      Brain.Screen.clearScreen();
      Brain.Screen.setFillColor(black);
      Brain.Screen.drawRectangle(0, 0, 479, 239);

      return 0;
    }
  }
  //Function that combines the Eject and Detect Color function. Depending on the alliance colors it rejects the opposite alliances color.
    void ColorSorting(){
      int colorDetected = DetectColor();
      //no color detected
      if  (colorDetected == 0) {
        CorrectColor();

      }
      //no color sorting for skills
      if (AllianceColor == 3){
        CorrectColor();
      }
      //Eject based on alliance color and color detected are not the same value
      if (AllianceColor != colorDetected) {
        //LEDG.on();
        Eject();
        }
      else {CorrectColor();};
      wait(10,msec);
    }


