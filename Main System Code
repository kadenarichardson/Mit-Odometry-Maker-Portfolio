//Pid Rotational Program
  //Max speed of the robot
    double MaxSpeed = 100;
  //Rotate left or right function
    void RotateFunction(double V) {
    //Rotate right and checks if the velocity of the loop is more than the max speed so it sets it to the max speed
    if (V > MaxSpeed) {
      RightMotorGroup(MaxSpeed*-1);
      LeftMotorGroup(MaxSpeed*1);
    }
    //does the same thing as above but for negative and left
    else if (V < MaxSpeed * -1) {
      RightMotorGroup(MaxSpeed*1);
      LeftMotorGroup(MaxSpeed*-1);
    }
    else {
      RightMotorGroup(V* -1);
      LeftMotorGroup(V* 1);
    }
    }
  //Rotate To heading
    void RotateToHeading(double DesiredHeading, double velocity, double Timeout){
        //Constants for Pid Loop
        double Kp = .35;
        double Ki = 0.00;
        double Kd = 0.28;
      //initalizes variables
        RightMotorGroup(velocity);
        LeftMotorGroup(velocity);
        //variables that change during the loop
        double Integral = 0;
        double PrevRemainingAngle = 0;
        double Derivative = 0;
        double CurrentAngle = 0;
        MaxSpeed = velocity;
        double RemainingAngle = DesiredHeading-InertialSensor.heading(degrees);
        MotorVelocityRotate = 0;
        //exits the loop when the remaing angle
        double StartTime = Brain.Timer.time(vex::timeUnits::msec); 
        while (fabs(RemainingAngle) >  1) {
          double ElapsedTime = Brain.Timer.time(vex::timeUnits::msec)-StartTime; 
          if (ElapsedTime > Timeout) {
            break;
          }
          Controller1.Screen.clearScreen();
          CurrentAngle = InertialSensor.heading(degrees);
          RemainingAngle = DesiredHeading - CurrentAngle;
          //clamps the code so that it goes the closest distance
          if (RemainingAngle > 180) RemainingAngle -= 360;
          if (RemainingAngle < -180) RemainingAngle += 360;
          //Variable redefinition
          Integral = (Integral+ RemainingAngle);
          Derivative = RemainingAngle - PrevRemainingAngle;
          MotorVelocityRotate = (RemainingAngle*Kp)+(Integral*Ki)+(Derivative*Kd);
          RotateFunction(MotorVelocityRotate);
          //determines the remaining angle for the next loop
          PrevRemainingAngle = RemainingAngle;
          //debugging incase the loop does not exit
          Controller1.Screen.print("loop cleared");
          wait(10,msec);
        }
        Controller1.Screen.print("loop exited");
        //stops all motors when the loop is exited
        RightMotorGroup(0);
        LeftMotorGroup(0);

    }  
