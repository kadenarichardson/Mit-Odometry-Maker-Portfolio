//Odometry block///////////////////////////////////////
  void Odometry() {
  //estabishes the variables that are only used in this function
    double DeltaXLocal = 0;
    double DeltaYLocal = 0;
  //Calibrates
  wait(0.3,seconds);
  HorizontalOdomWheel.setPosition(0,degrees);
  VerticalOdomWheel.setPosition(0,degrees);
  InertialSensor.calibrate();
  wait(0.3,seconds);
  //initialize variables 
  double PreviousH = HorizontalOdomWheel.position(degrees) * OdomWheelCircum/360;
  double PreviousV = VerticalOdomWheel.position(degrees)* OdomWheelCircum/360;
  //Previous Angle (theta) in Radians
  double PreviousT = 0;
  //while loop for Odom
  while (true) {
  //Calculates the distance in inches that the motor is in
   double CurrentH =  HorizontalOdomWheel.position(degrees) * OdomWheelCircum/360;
   double CurrentV =  VerticalOdomWheel.position(degrees)* OdomWheelCircum/360;
   //In Radians
   double CurrentT = InertialSensor.heading(degrees)* (3.1415912/180);
  //calculates the change in distance for the motor encoders
   double DeltaH = CurrentH - PreviousH;
   double DeltaV = CurrentV - PreviousV;
   double DeltaTheta = CurrentT - PreviousT;
  //keeps angle between 2pi radians and -2pi radians
  if (DeltaTheta > M_PI) DeltaTheta -= 2 * M_PI;
  if (DeltaTheta < -M_PI) DeltaTheta += 2 * M_PI;

  //makes it so if there is tiny movements from sensor drift it does constantly add numbers
  //if (fabs(DeltaH < 0.05) and fabs(DeltaV < 0.05)) {
      //DeltaTheta = 0;
  //}

  if (fabs(DeltaTheta < 0.001)) {
      DeltaTheta = 0;
  }
  //Determines change in heading is 0
  //if it is zero It just adds the local Odom X same for Y but with V
  if (DeltaTheta == 0) {
    DeltaXLocal = DeltaH;
    DeltaYLocal = DeltaV;
  }
  //Chord formula 
  else {
    DeltaXLocal = 2*sin(DeltaTheta/2)*((DeltaH/DeltaTheta) + HorizDistToTrackPt);
    DeltaYLocal = 2*sin(DeltaTheta/2)*((DeltaV/DeltaTheta) + VertDistToTrackPt);
  } 
  //average orientation of Robot
  double AvgOrient = PreviousT + (DeltaTheta/2);
  
  //To convert the cartesian coordinates to polar that we calculated 
  //We need the Radius and the angle of the coordinates
  double RadiusOfCortesian = sqrt((DeltaXLocal*DeltaXLocal)+(DeltaYLocal*DeltaYLocal));
  double CortesianTheta = atan2(DeltaYLocal,DeltaXLocal);

  //Rotate the cords by the Average Orientation 
  double GlobalTheta = CortesianTheta + AvgOrient;

  //Cords to the cords by cortesian coordinates
  double GlobalX = RadiusOfCortesian * cos(GlobalTheta);
  double GlobalY = RadiusOfCortesian * sin(GlobalTheta);

  //Adds the X cordinate that we converted into the x value
  X -= GlobalX;
  Y += GlobalY;
  //prints the X and Y and the Heading
  Brain.Screen.setCursor(1,2);
  Brain.Screen.print("X: %.2f", X);
  Brain.Screen.setCursor(3,2);
  Brain.Screen.print("Y: %.2f",Y);
  Brain.Screen.setCursor(2,2);
  Brain.Screen.print("Heading: %.2f",InertialSensor.heading(degrees));

  //establishes previous values for the change.
   PreviousH = CurrentH;
   PreviousV = CurrentV;
   PreviousT = CurrentT;

  wait(5,msec); 
  }
  }


