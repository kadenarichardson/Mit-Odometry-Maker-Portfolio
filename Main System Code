        }
        //Determines whether the angle is less that -90. it flips the angle +180 degrees so that it would be in the perfect position to go backwards.
        if (RemainingAngle < -90) {
          RemainingAngle += 180;
          backwards = 1;

        } 

      
        //Integral for Drive and Rotate
        DriveIntegral = (DriveIntegral+ RemainingDist);
        RotateIntegral = (RotateIntegral+ RemainingAngle);
        
        //Derivative for Drive and Rotate
        RotateDerivative = RemainingAngle - PrevRemainingAngle;
        DriveDerivative = RemainingDist - PrevRemainingDist;
        
        //Formula for Motor Velocities
        MotorVelocityDrive = (RemainingDist*DriveKp)+(DriveIntegral*DriveKi)+(DriveDerivative*DriveKd);
    
        //reverse the direction if it is called for
          if (backwards == 1) {
            MotorVelocityDrive = MotorVelocityDrive * -1;
          }

        MotorVelocityRotate = (RemainingAngle*RotateKp)+(RotateIntegral*RotateKi)+(RotateDerivative*RotateKd);
        
        
  
        //Makes a minimun speed
            if (fabs(MotorVelocityDrive) < MinSpeed)
                  MotorVelocityDrive = copysign(MinSpeed, MotorVelocityDrive);
        //Slows down Pid At a certain distance
            if (RemainingDist < 6)
              MotorVelocityDrive *= RemainingDist / 6.0;

          //clamps the motor velocity to max velocity
          if (MotorVelocityDrive > Velocity) MotorVelocityDrive = Velocity;
          if (MotorVelocityDrive < -Velocity) MotorVelocityDrive = -Velocity;
          if (MotorVelocityRotate > Velocity) MotorVelocityRotate =Velocity;
          if (MotorVelocityRotate < -Velocity) MotorVelocityRotate = -Velocity;
        
        //Motor groups moving
        LeftMotorGroup((MotorVelocityDrive + MotorVelocityRotate));
        RightMotorGroup((MotorVelocityDrive - MotorVelocityRotate));
         
        

        //determines the remaining angle for the next loop
        PrevRemainingDist = RemainingDist;
        //determines the remaining angle for the next loop
        PrevRemainingAngle = RemainingAngle;
        wait(5,msec);
    
    }
      Controller1.Screen.print("Loop Exited");
      RightMotorGroup(0);
      LeftMotorGroup(0);

    }  
